# WiFi support for MediaTek MT7981/MT7986 devices
# Note: In-kernel mt76 has build issues. Full WiFi requires the separate
# mt76 package with mac80211-backport (not yet ported to this build system).

# Wireless core - enable mac80211 for future mt76 package
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_MAC80211_LEDS=y
CONFIG_MAC80211_MESH=y

# MT76 driver - DISABLED due to build errors
# OpenWrt uses out-of-tree mt76 from https://github.com/openwrt/mt76
# with mac80211-backport, not the in-kernel driver.
# CONFIG_WLAN_VENDOR_MEDIATEK is not set

# Crypto support needed for WiFi
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CCM=m
CONFIG_CRYPTO_GCM=m
CONFIG_CRYPTO_CMAC=m

# Relay for debugging
CONFIG_RELAY=y
