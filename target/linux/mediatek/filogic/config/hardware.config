# Hardware support for MediaTek MT7981/MT7986 devices
# LEDs, GPIOs, buttons, crypto acceleration

# LED support
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=m
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_TRANSIENT=y
CONFIG_LEDS_TRIGGER_NETDEV=y

# GPIO button support
CONFIG_KEYBOARD_GPIO=m
CONFIG_KEYBOARD_GPIO_POLLED=m

# Crypto hardware acceleration (SafeXcel)
CONFIG_CRYPTO_HW=y
CONFIG_CRYPTO_DEV_SAFEXCEL=m

# USB support (for USB3)
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_MTK=m
