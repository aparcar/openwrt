# OpenWrt Build System - Base Image
#
# This is the bootstrap layer with Ubuntu and system packages needed to:
# 1. Build host tools from source
# 2. Build cross-toolchains
# 3. Compile packages and kernels
#
# This image is NOT used directly - it's the foundation for owrt-tools.

FROM ubuntu:24.04

LABEL maintainer="OpenWrt Developers"
LABEL description="OpenWrt Base Build Environment"

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install all host dependencies
# These are system packages needed to bootstrap the build environment
RUN apt-get update && apt-get install -y \
    # Essential build tools
    build-essential \
    clang \
    flex \
    bison \
    g++ \
    gawk \
    gcc-multilib \
    g++-multilib \
    gettext \
    git \
    libelf-dev \
    libncurses5-dev \
    libssl-dev \
    python3 \
    python3-pip \
    python3-setuptools \
    python3-venv \
    rsync \
    swig \
    unzip \
    zlib1g-dev \
    file \
    wget \
    curl \
    xz-utils \
    # For toolchain build (GCC bootstrap)
    texinfo \
    help2man \
    gperf \
    autoconf \
    automake \
    libtool \
    libgmp-dev \
    libmpfr-dev \
    libmpc-dev \
    libisl-dev \
    libzstd-dev \
    zstd \
    # For kernel build
    bc \
    kmod \
    cpio \
    # For device tree
    device-tree-compiler \
    # System squashfs-tools as fallback
    squashfs-tools \
    # For mtd-utils build
    liblzma-dev \
    uuid-dev \
    # For Lua build
    libreadline-dev \
    # For U-Boot/mkimage build
    xxd \
    e2fsprogs \
    dosfstools \
    mtools \
    fdisk \
    gdisk \
    parted \
    # For package isolation
    fakeroot \
    fakechroot \
    proot \
    # Build systems (for building our tools)
    ninja-build \
    cmake \
    meson \
    pkg-config \
    # Compilation cache
    ccache \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for builds
RUN useradd -m -s /bin/bash builder && \
    mkdir -p /build /output && \
    chown -R builder:builder /build /output

# Set up Python virtual environment with required packages
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir pyyaml jsonschema click rich

# Build environment variables
ENV FORCE_UNSAFE_CONFIGURE=1
ENV LC_ALL=C
ENV LANG=C

WORKDIR /build
